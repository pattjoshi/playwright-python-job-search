# Copy this file to .env and fill it in. Never commit .env.
#   Windows:     copy .env.example .env
#   macOS/Linux: cp .env.example .env

# ---- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Any chat model that supports JSON output. A small model keeps cost low.
OPENAI_MODEL=gpt-5.4-mini

# ---- Your search defaults ------------------------------------------------
# Set these once, then just run:  python -m job_search
# Every setting matches a command-line option (RESULTS <-> --results), and
# the command line wins when you pass both. Leave a line empty or commented
# out to use the default shown.

# Your resume: a file name in this folder (Omprakash_Resume.pdf) or a full path.
# On Windows use forward slashes, e.g. C:/Users/you/Documents/resume.pdf
RESUME=

# Where to search, separated by commas, e.g. Pune, Bengaluru, Remote.
# Empty = use the location found in your resume.
LOCATION=

# Search phrases, separated by commas. Empty = let the AI pick them from your resume.
KEYWORDS=

# Jobs shown per site, best first (default 10) ...
RESULTS=10
# ... or a different number for each site (the web UI starts with these too).
RESULTS_LINKEDIN=20
RESULTS_NAUKRI=12
RESULTS_INDEED=10

# Years of experience you want, e.g. 1-2 or 3. Empty = any.
EXPERIENCE=

# Only jobs posted within this many hours (default 24).
HOURS=24

# true = only show jobs you haven't been shown before (default false).
ONLY_NEW=false

# Job boards to search, separated by commas. Empty = all. Available: linkedin, naukri, indeed
SITES=

# Jobs per site to open and score with AI (default 40). Higher = slower, a bit more cost.
TOP=40

# Result pages to read per search (default 3).
MAX_PAGES=3

# Delete uploaded resumes, old reports and cached data after this many days (default 30).
# 0 = keep forever. Your job history (applied/hidden/seen) is never deleted.
KEEP_DAYS=30

# Search all job sites at the same time, one browser each (default true). Set false to go one by one.
PARALLEL_SITES=true

# Optional: OpenAI prices in USD per 1M tokens, to show an estimated cost per run.
# Copy them from your model's pricing page. Leave empty to show token counts only.
OPENAI_PRICE_INPUT=
OPENAI_PRICE_OUTPUT=
OPENAI_PRICE_CACHED_INPUT=

# ---- Advanced ------------------------------------------------------------
# Where seen / applied / hidden jobs are remembered.
# HISTORY_DB=data/history.sqlite3

# Use a specific Chromium/Chrome binary instead of Playwright's bundled one.
# CHROMIUM_EXECUTABLE=
